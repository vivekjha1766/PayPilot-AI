# PayPilot AI Environment Configuration Template
# Duplicate this file as .env and fill in values. DO NOT commit .env.

APP_NAME="PayPilot AI"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (Async SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db

# PayPal Sandbox Settings (Milestone 2)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD

# Gemini AI (Milestone 3+)
GEMINI_API_KEY=
