# PayPilot AI Environment Configuration Template
# Duplicate this file as .env and fill in values. DO NOT commit .env.

APP_NAME="PayPilot AI"
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (Async SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./paypilot.db

# Milestone 2+ Settings (Leave blank or mock during Milestone 1)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=
